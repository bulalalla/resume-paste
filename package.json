{
  "name": "resume-dock",
  "productName": "简历随手贴",
  "version": "0.4.0",
  "private": true,
  "description": "本地优先的简历投递悬浮助手",
  "author": "Resume Dock",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "python3 -m http.server 4173 --directory src",
    "test": "node --test test/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "icons": "electron scripts/build-icons.cjs",
    "demo:generate": "electron scripts/generate-demo.cjs"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.resumedock.app",
    "files": [
      "main.cjs",
      "preload.cjs",
      "shortcuts.cjs",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "resume-paste-${version}-macos-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "resume-paste-${version}-windows-${arch}-setup.${ext}"
    },
    "artifactName": "resume-paste-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "resume-paste-${version}-windows-${arch}-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bulalalla/resume-paste.git"
  }
}
